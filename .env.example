# ==============================================================================
# Crypto Market Surveillance & Streaming Data Platform - Environment Config
# ==============================================================================

# --- Environment & Runtime ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Apache Kafka (KRaft Mode: internal=kafka:9092, host=127.0.0.1:9094) ---
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094
KAFKA_CLIENT_ID=crypto-surveillance
KAFKA_COMPRESSION_TYPE=lz4

# --- ClickHouse OLAP Server ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=crypto
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Redis 8 (In-Memory Serving & Streams) ---
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# --- Binance Endpoints & Credentials ---
BINANCE_SPOT_WS_URL=wss://data-stream.binance.vision/stream
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/stream
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_S3_BASE_URL=https://data.binance.vision/data/spot/daily/aggTrades
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# --- PySpark Structured Streaming ---
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=1100m
SPARK_SHUFFLE_PARTITIONS=6
SPARK_MAX_RATE_PER_PARTITION=2500
SPARK_CHECKPOINT_DIR=/data/checkpoints

# --- FastAPI & Security ---
API_HOST=0.0.0.0
API_PORT=8000
ENABLE_2FA=false
TOTP_SECRET=

# --- Telegram Notification Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COOLDOWN_SECONDS=60
